import { fileURLToPath } from 'url'
import isEqual from 'fast-deep-equal'
import { $, fs, usePowerShell } from 'zx'
import {
	borderFields,
	boundsFields,
	canvasElementSchema,
	elementSchemas,
	getDefaultPinnedProperties,
	rotationFields,
} from '../shared-lib/lib/Graphics/ElementPropertiesSchemas.ts'
import { SomeCompanionInputField } from '../shared-lib/lib/Model/Options.ts'
import { ButtonGraphicsDecorationType } from '../shared-lib/lib/Model/StyleModel.ts'
import { capitalize } from '../shared-lib/lib/Util.ts'

if (process.platform === 'win32') {
	usePowerShell() // to enable powershell
}

let generatedFile = '/* eslint-disable */\n// This file is autogenerated by tools/generate_graphics_types.mts\n\n'
generatedFile += `import type { JsonValue } from 'type-fest'\n`
generatedFile += `import z from 'zod'\n`
generatedFile += `import { createExpressionOrValueSchema, ExpressionOrJsonValueSchema, JsonValueSchema, type ExpressionOrValue } from '../Model/Options.js'\n`
generatedFile += `import { ButtonGraphicsElementUsage, ButtonGraphicsDecorationType, type ButtonGraphicsShowStatusIcons, type HorizontalAlignment, type VerticalAlignment, type TextStyle, type ColorValue, type CompositeElementOptionKey } from './StyleModel.js'\n`
generatedFile += '\n'

const baseFieldGroups = {
	bounds: boundsFields,
	border: borderFields,
	rotation: rotationFields,
}

// ---- The draw elements: computed when drawing a button, so only typed ----

function convertFieldType(field: SomeCompanionInputField): string {
	switch (field.type) {
		case 'number':
			// A nullable ("auto") number field can hold null in addition to a number.
			return field.allowNull ? 'number | null' : 'number'
		case 'textinput':
			return 'string'
		case 'checkbox':
			return 'boolean'
		case 'colorpicker':
			return 'ColorValue'
		case 'dropdown':
			if (field.allowCustom) return 'string'
			return field.choices.map((choice) => JSON.stringify(choice.id)).join(' | ')
		case 'internal:image-file':
			return 'string | null'
		case 'internal:horizontal-alignment':
			return 'HorizontalAlignment'
		case 'internal:vertical-alignment':
			return 'VerticalAlignment'
		case 'internal:text-styles':
			return 'TextStyle[]'
		case 'internal:table':
		case 'internal:list':
			return 'Record<string, JsonValue>[]'
		default:
			throw new Error(`Unhandled field type: ${field.type}`)
	}
}

generatedFile += 'export interface ButtonGraphicsDrawBase {\n'
generatedFile += `\treadonly id: string\n`
generatedFile += `\tusage: ButtonGraphicsElementUsage\n`
generatedFile += `\tenabled: boolean\n`
generatedFile += `\topacity: number\n`
generatedFile += `\t/** A hash of the element content, used for render cache key generation */\n`
generatedFile += `\tcontentHash: string\n`
generatedFile += '}\n\n'

for (const [id, fields] of Object.entries(baseFieldGroups)) {
	generatedFile += `export interface ButtonGraphicsDraw${capitalize(id)} {\n`
	for (const field of fields) generatedFile += `\t${field.id}: ${convertFieldType(field)}\n`
	generatedFile += '}\n\n'
}

generatedFile += `export interface ButtonGraphicsCanvasDrawElement extends Omit<ButtonGraphicsDrawBase, 'enabled' | 'opacity'> {\n`
generatedFile += `\t// Note: this is the background element and can only be at the bottom of the stack\n`
generatedFile += `\ttype: 'canvas'\n`
for (const field of canvasElementSchema.flatMap((s) => s.fields)) {
	if (field.id === 'decoration') {
		generatedFile += `\tdecoration: ButtonGraphicsDecorationType // replaces show_topbar\n`
	} else if (field.id === 'showStatusIcons') {
		generatedFile += `\tshowStatusIcons: ButtonGraphicsShowStatusIcons\n`
	} else {
		generatedFile += `\t${field.id}: ${convertFieldType(field)}\n`
	}
}
generatedFile += '}\n\n'

const allDrawElementTypes: string[] = ['ButtonGraphicsCanvasDrawElement']

for (const [id, sections] of Object.entries(elementSchemas)) {
	// The canvas is above, and a composite element is drawn as the elements of its definition
	if (id === 'canvas' || id === 'composite') continue
	const fields = sections.flatMap((s) => s.fields)

	const drawInterfaces = ['ButtonGraphicsDrawBase']
	const ignoreFields = new Set(['enabled', 'opacity'])
	for (const [groupId, groupFields] of Object.entries(baseFieldGroups)) {
		if (groupFields.every((groupField) => fields.find((field) => isEqual(field, groupField)))) {
			drawInterfaces.push(`ButtonGraphicsDraw${capitalize(groupId)}`)
			for (const field of groupFields) ignoreFields.add(field.id)
		}
	}

	const drawElementName = `ButtonGraphics${capitalize(id)}DrawElement`
	allDrawElementTypes.push(drawElementName)

	generatedFile += `export interface ${drawElementName} extends ${drawInterfaces.join(', ')} {\n`
	generatedFile += `\ttype: '${id}'\n`
	if (id === 'reference') {
		// A reference is drawn as the elements of the button it refers to
		generatedFile += `\tchildren: SomeButtonGraphicsDrawElement[]\n`
	} else {
		for (const field of fields) {
			if (!ignoreFields.has(field.id)) generatedFile += `\t${field.id}: ${convertFieldType(field)}\n`
		}
		if (id === 'group') generatedFile += `\tchildren: SomeButtonGraphicsDrawElement[]\n`
	}
	generatedFile += '}\n\n'
}

generatedFile += `export type SomeButtonGraphicsDrawElement =\n`
for (const typeName of allDrawElementTypes) generatedFile += `\t| ${typeName}\n`
generatedFile += '\n'

// ---- The stored elements: a schema each, which their types are inferred from ----
// Each property falls back to its default when missing or invalid, as a bad visual property shouldn't lose the element

function convertFieldZod(field: SomeCompanionInputField): string {
	switch (field.type) {
		case 'number':
			return field.allowNull ? 'z.number().nullable()' : 'z.number()'
		case 'textinput':
			return 'z.string()'
		case 'checkbox':
			return 'z.boolean()'
		case 'colorpicker':
			return 'z.union([z.number(), z.string()])'
		case 'dropdown':
			if (field.allowCustom) return 'z.string()'
			return `z.literal(${JSON.stringify(field.choices.map((choice) => choice.id))})`
		case 'internal:image-file':
			return 'z.string().nullable()'
		case 'internal:horizontal-alignment':
			return `z.literal(['left', 'center', 'right'])`
		case 'internal:vertical-alignment':
			return `z.literal(['top', 'center', 'bottom'])`
		case 'internal:text-styles':
			return `z.array(z.literal(['italic', 'underline', 'strikethrough']))`
		case 'internal:table':
		case 'internal:list':
			return 'z.array(z.record(z.string(), JsonValueSchema))'
		default:
			throw new Error(`Unhandled field type: ${field.type}`)
	}
}

function expressionableFieldZod(field: SomeCompanionInputField, inner: string, enumName: string | null): string {
	if (!('default' in field) || field.default === undefined) throw new Error(`Field ${field.id} has no default`)

	let value: string
	if (enumName) {
		// The default as a member of the enum
		const enumObject = enumName === 'ButtonGraphicsDecorationType' ? ButtonGraphicsDecorationType : undefined
		const member = enumObject && Object.entries(enumObject).find(([, enumValue]) => enumValue === field.default)?.[0]
		if (!member) throw new Error(`No member of ${enumName} for the default of ${field.id}`)
		value = `${enumName}.${member}`
	} else if (typeof field.default === 'string') {
		// Keep a string default as its literal type, for fields that are a choice of strings
		value = `${JSON.stringify(field.default)} as const`
	} else {
		value = JSON.stringify(field.default)
	}
	return `createExpressionOrValueSchema(${inner}).catch(() => ({ isExpression: false as const, value: ${value} }))`
}

function fieldShape(field: SomeCompanionInputField): string {
	return `\t${field.id}: ${expressionableFieldZod(field, convertFieldZod(field), null)},\n`
}

function exportSchemaAndType(name: string, schema: string): void {
	generatedFile += `export const ${name}Schema = ${schema}\n\n`
	generatedFile += `export type ${name} = z.output<typeof ${name}Schema>\n\n`
}

// The parts shared by elements, for code that handles any element with them
const commonFields = elementSchemas.text.flatMap((s) => s.fields).filter((f) => f.id === 'enabled' || f.id === 'opacity')
let elementBase = 'z.object({\n'
elementBase += `\tid: z.string(),\n`
elementBase += `\tname: z.string().catch(''),\n`
elementBase += `\tusage: z.enum(ButtonGraphicsElementUsage).catch(ButtonGraphicsElementUsage.Automatic),\n`
for (const field of commonFields) elementBase += fieldShape(field)
elementBase += `\t/** Ids of the properties pinned to this button's pinned view */\n`
elementBase += `\tpinnedProperties: z.array(z.string()).catch(() => []),\n`
elementBase += '})'
exportSchemaAndType('ButtonGraphicsElementBase', elementBase)

for (const [id, fields] of Object.entries(baseFieldGroups)) {
	exportSchemaAndType(`ButtonGraphics${capitalize(id)}`, `z.object({\n${fields.map(fieldShape).join('')}})`)
}

// Each element's schema is built as an object, for the discriminated union, and exported annotated with its type
const allElementObjectSchemas: string[] = []
const allElementTypes: string[] = []
for (const [id, sections] of Object.entries(elementSchemas)) {
	const fields = sections.flatMap((s) => s.fields)
	const typeName = capitalize(id)
	const name = `ButtonGraphics${typeName}Element`
	const objectSchemaName = `buttonGraphics${typeName}ElementObjectSchema`
	allElementObjectSchemas.push(objectSchemaName)
	allElementTypes.push(name)

	let shape = ''
	if (id === 'canvas') shape += `\t// Note: this is the background element and can only be at the bottom of the stack\n`
	shape += `\ttype: z.literal('${id}'),\n`
	shape += `\tid: z.string(),\n`
	shape += `\tname: z.string().catch(${JSON.stringify(typeName)}),\n`
	shape += `\tusage: z.enum(ButtonGraphicsElementUsage).catch(ButtonGraphicsElementUsage.Automatic),\n`
	if (id !== 'canvas') {
		shape += `\t/** Ids of the properties pinned to this button's pinned view */\n`
		shape += `\tpinnedProperties: z.array(z.string()).catch(() => ${JSON.stringify(getDefaultPinnedProperties(id))}),\n`
	}
	for (const field of fields) {
		if (id === 'canvas' && field.id === 'decoration') {
			shape += `\tdecoration: ${expressionableFieldZod(field, 'z.enum(ButtonGraphicsDecorationType)', 'ButtonGraphicsDecorationType')},\n`
		} else {
			shape += fieldShape(field)
		}
	}
	if (id === 'group') {
		// The type is recursive through the children, so they are added to the type of the rest explicitly
		const knownSchemaName = `buttonGraphics${typeName}ElementKnownSchema`
		generatedFile += `const ${knownSchemaName} = z.object({\n${shape}})\n\n`
		generatedFile += `export type ${name} = z.output<typeof ${knownSchemaName}> & {\n`
		generatedFile += `\tchildren: SomeButtonGraphicsElement[]\n`
		generatedFile += `}\n\n`
		generatedFile += `const ${objectSchemaName} = ${knownSchemaName}.extend({\n`
		generatedFile += `\tget children(): z.ZodDefault<z.ZodArray<z.ZodType<SomeButtonGraphicsElement>>> {\n`
		generatedFile += `\t\treturn z.array(SomeButtonGraphicsElementSchema).default(() => [])\n`
		generatedFile += `\t},\n`
		generatedFile += `})\n\n`
	} else if (id === 'composite') {
		shape += `\tconnectionId: z.string(),\n`
		shape += `\telementId: z.string(),\n`

		// A catchall can only be typed with a string index, which the other properties would have to match. So the
		// type is the known properties, with the options of the composite definition typed by their key
		const knownSchemaName = `buttonGraphics${typeName}ElementKnownSchema`
		generatedFile += `const ${knownSchemaName} = z.object({\n${shape}})\n\n`
		generatedFile += `export type ${name} = z.output<typeof ${knownSchemaName}> & {\n`
		generatedFile += `\t/** Custom elements have options defined by their composite definition */\n`
		generatedFile += `\t[customKey: CompositeElementOptionKey]: ExpressionOrValue<JsonValue | undefined> | undefined\n`
		generatedFile += `}\n\n`
		generatedFile += `const ${objectSchemaName} = ${knownSchemaName}.catchall(ExpressionOrJsonValueSchema.optional())\n\n`
	} else {
		generatedFile += `const ${objectSchemaName} = z.object({\n${shape}})\n\n`
		generatedFile += `export type ${name} = z.output<typeof ${objectSchemaName}>\n\n`
	}
	generatedFile += `export const ${name}Schema: z.ZodType<${name}> = ${objectSchemaName}\n\n`
}

generatedFile += `export type SomeButtonGraphicsElement =\n`
for (const name of allElementTypes) generatedFile += `\t| ${name}\n`
generatedFile += '\n'
generatedFile += `export const SomeButtonGraphicsElementSchema: z.ZodType<SomeButtonGraphicsElement> = z.discriminatedUnion('type', [\n`
for (const name of allElementObjectSchemas) generatedFile += `\t${name},\n`
generatedFile += `])\n`

/** The generated file, before it is formatted */
export const generatedGraphicsTypes = generatedFile

export const graphicsTypesPath = fileURLToPath(new URL('../shared-lib/lib/Model/StyleLayersModel.ts', import.meta.url))

// Only write the file when run, not when imported by the test that checks it is up to date
if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
	await fs.writeFile(graphicsTypesPath, generatedGraphicsTypes, 'utf8')

	await $`prettier --write ${graphicsTypesPath}`
}
