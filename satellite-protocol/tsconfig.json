{
	"include": ["lib/**/*.ts"],
	"exclude": ["node_modules/**", "lib/**/__tests__/**"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./lib",
		"module": "Node16",
		"moduleResolution": "Node16",
		"composite": true,

		"target": "es2022",
		"noImplicitAny": true,
		"sourceMap": false,
		"declaration": true,
		"declarationMap": false,
		"importHelpers": false,
		"listFiles": false,
		"traceResolution": false,
		"pretty": true,
		"lib": ["es2022"],
		// No @types/node: the package must stay isomorphic (browser, node, bundlers)
		"types": [],
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true
	}
}
