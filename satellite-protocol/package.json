{
  "name": "@companion-app/satellite-protocol",
  "version": "0.1.0",
  "description": "Wire protocol definitions for the Bitfocus Companion Satellite API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfocus/companion.git",
    "directory": "satellite-protocol"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "companion:source": "./lib/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codec": {
      "companion:source": "./lib/codec.ts",
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./constants": {
      "companion:source": "./lib/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./versions": {
      "companion:source": "./lib/versions.ts",
      "types": "./dist/versions.d.ts",
      "default": "./dist/versions.js"
    },
    "./schemas": {
      "companion:source": "./lib/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/tsconfig.tsbuildinfo",
    "assets"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
