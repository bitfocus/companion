		"SurfaceSchemaLayoutDefinition": {
			"type": "object",
			"properties": {
				"stylePresets": {
					"type": "object",
					"properties": {
						"default": {
							"$ref": "#/$defs/SurfaceSchemaControlStylePreset"
						}
					},
					"required": [
						"default"
					],
					"additionalProperties": {
						"$ref": "#/$defs/SurfaceSchemaControlStylePreset"
					},
					"description": "Named collection of style presets. The preset named `default` is required and is used as the fallback style for controls when no `stylePreset` is specified."
				},
				"controls": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"pattern": "^[a-zA-Z0-9\\-/]+$"
					},
					"additionalProperties": {
						"$ref": "#/$defs/SurfaceSchemaControlDefinition"
					}
				}
			},
			"required": [
				"stylePresets",
				"controls"
			],
			"description": "Schema describing a surface layout: default styling and a map of controls with positions and optional style overrides.",
			"title": "SurfaceSchemaLayoutDefinition"
		},
		"SurfaceSchemaControlStylePreset": {
			"type": "object",
			"properties": {
				"bitmap": {
					"description": "If set, bitmaps of the specified size will be reported.",
					"$ref": "#/$defs/SurfaceSchemaBitmapConfig"
				},
				"text": {
					"description": "If true, the control requests text to be reported.",
					"type": "boolean"
				},
				"textStyle": {
					"description": "If true, the control requests text style properties to be reported",
					"type": "boolean"
				},
				"colors": {
					"description": "If set, the control requests colours to be reported.",
					"type": "string",
					"enum": [
						"hex",
						"rgb"
					]
				},
				"leds": {
					"description": "If set, the control has an addressable strip/ring of LEDs and requests LED colours to be reported.",
					"$ref": "#/$defs/SurfaceSchemaLedsConfig"
				}
			},
			"description": "Styling options that can be applied to controls. Can be used as the default style or as per-control overrides.",
			"title": "SurfaceSchemaControlStylePreset"
		},
		"SurfaceSchemaBitmapConfig": {
			"type": "object",
			"properties": {
				"w": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991,
					"description": "Width in pixels (non-negative)."
				},
				"h": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991,
					"description": "Height in pixels (non-negative)."
				},
				"format": {
					"default": "rgb",
					"$ref": "#/$defs/SurfaceSchemaPixelFormat"
				}
			},
			"required": [
				"w",
				"h"
			],
			"description": "Bitmap content dimensions and format.",
			"title": "SurfaceSchemaBitmapConfig"
		},
		"SurfaceSchemaPixelFormat": {
			"type": "string",
			"enum": [
				"rgb",
				"rgba",
				"bgr",
				"bgra"
			],
			"description": "Buffer pixel format",
			"title": "SurfaceSchemaPixelFormat"
		},
		"SurfaceSchemaLedsConfig": {
			"type": "object",
			"properties": {
				"segments": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9007199254740991,
					"description": "The number of individually addressable LED segments."
				},
				"mode": {
					"type": "string",
					"enum": [
						"full-ring",
						"simple"
					],
					"description": "How Companion maps a gauge onto these LEDs. `full-ring`: the LEDs form a complete circle and the gauge is rendered faithfully (angles, deadzone and colours respected 1:1); segment 0 is at 6 o'clock and indices increase clockwise. `simple`: any other shape  where the value is swept across all segments, with segment 0 as the 0% end. In both cases the surface re-maps to its physical wiring locally if it differs from these conventions."
				}
			},
			"required": [
				"segments",
				"mode"
			],
			"description": "If set, the control has an addressable strip/ring of LEDs (e.g. the ring around a Stream Deck Studio encoder) and requests LED colours to be reported. Colours are reported via `SurfaceDrawProps.leds` as a packed RGB buffer, one entry per segment.",
			"title": "SurfaceSchemaLedsConfig"
		},
		"SurfaceSchemaControlDefinition": {
			"type": "object",
			"properties": {
				"row": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991,
					"description": "Zero-based row index for layout placement."
				},
				"column": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991,
					"description": "Zero-based column index for layout placement."
				},
				"stylePreset": {
					"description": "Optional name of a style preset defined in `stylePresets`. If present, the control will use the named preset instead of the default style.",
					"type": "string",
					"pattern": "^.+$"
				}
			},
			"required": [
				"row",
				"column"
			],
			"description": "Single control definition. The id must be unique and may be user facing in logs. Typically the id would be in the form of 1/0, matching the row/column of the control.",
			"title": "SurfaceSchemaControlDefinition"
		},
		"SurfaceAppearanceDefinition": {
			"type": "object",
			"properties": {
				"size": {
					"$ref": "#/$defs/SurfaceAppearanceSize"
				},
				"bodyColor": {
					"type": "string",
					"pattern": "^#[0-9a-fA-F]{6}$",
					"description": "The colour of the device itself, as `#rrggbb` - the colour of the plastic, not a colour chosen to suit a theme. With no `bodyImage` it fills the face; with one it says what the device looks like, so the face can be told apart from whatever is behind it."
				},
				"bodyImage": {
					"description": "Artwork for the face, drawn over `bodyColor` and under the controls, as a base64 `data:` URI. SVG is preferred; a raster is accepted for simple cases, but the whole URI is limited to 512KiB. An SVG must use a `viewBox` of `0 0 <size.width> <size.height>` so that the art and the control positions share one coordinate system; a raster is scaled to fill `size` exactly.",
					"type": "string",
					"maxLength": 524288,
					"pattern": "^data:image\\/(svg\\+xml|png|webp);base64,(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{4}|[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)$"
				},
				"controls": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"pattern": "^[a-zA-Z0-9\\-/]+$"
					},
					"additionalProperties": {
						"$ref": "#/$defs/SurfaceControlAppearance"
					},
					"description": "Where each control sits, keyed by the same control ids as the layout this appearance accompanies. Must cover every control the layout has, or the whole appearance is ignored. Ids the layout does not have are ignored."
				}
			},
			"required": [
				"size",
				"bodyColor",
				"controls"
			],
			"description": "Schema describing how to draw the face of a surface: its extent, its background, and where each of its controls is. Layered over a surface layout and keyed by the same control ids.",
			"title": "SurfaceAppearanceDefinition"
		},
		"SurfaceAppearanceSize": {
			"type": "object",
			"properties": {
				"width": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Width of the whole face, in face units."
				},
				"height": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Height of the whole face, in face units."
				}
			},
			"required": [
				"width",
				"height"
			],
			"description": "The extent of the whole face. Every other measurement in the appearance is in these units.",
			"title": "SurfaceAppearanceSize"
		},
		"SurfaceControlAppearance": {
			"type": "object",
			"properties": {
				"x": {
					"type": "number",
					"description": "Distance from the left edge of the face to the left edge of the control, in face units."
				},
				"y": {
					"type": "number",
					"description": "Distance from the top edge of the face to the top edge of the control, in face units."
				},
				"width": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Width of the control, in face units."
				},
				"height": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "Height of the control, in face units."
				},
				"shape": {
					"description": "How the control is drawn. An `encoder` is always an ellipse, so this is ignored for one. Defaults to an ellipse for a `jog` or `shuttle`, and otherwise a square-cornered rectangle filling the bounds.",
					"$ref": "#/$defs/SurfaceControlShape"
				},
				"kind": {
					"description": "What kind of control this is, so it can be drawn as one - a knob rather than a round button. Defaults to a button.",
					"type": "string",
					"enum": [
						"button",
						"encoder",
						"jog",
						"shuttle",
						"lcd-segment"
					]
				},
				"label": {
					"description": "The legend printed on the hardware, if it has one, eg `CUT`. Drawn on the face where there is no artwork.",
					"type": "string",
					"maxLength": 64
				}
			},
			"required": [
				"x",
				"y",
				"width",
				"height"
			],
			"description": "Where one control sits on the face and how it is drawn. A control may overhang `size`, and controls may overlap - a later entry is drawn, and hit tested, on top of an earlier one.",
			"title": "SurfaceControlAppearance"
		},
		"SurfaceControlShape": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"shape": {
							"type": "string",
							"const": "rect"
						},
						"cornerRadius": {
							"default": 0,
							"description": "Corner radius in face units. Omit or use `0` for square corners, or half the shorter side for fully rounded ends, as on a touch strip segment.",
							"type": "number",
							"minimum": 0
						}
					},
					"required": [
						"shape"
					],
					"description": "A rectangle filling the control bounds, optionally with rounded corners."
				},
				{
					"type": "object",
					"properties": {
						"shape": {
							"type": "string",
							"const": "ellipse"
						}
					},
					"required": [
						"shape"
					],
					"description": "An ellipse inscribed in the control bounds, which in square bounds is a circle."
				}
			],
			"description": "How a control is drawn.",
			"title": "SurfaceControlShape"
		}
	}
}
